  "@type": "sc:Dataset",
  "name": "AET-Bench",
  "description": "AET-Bench: A Comprehensive Benchmark for Atomic Electron Tomography Reconstruction. 755 samples across 6 data tiers (analytical simulation, binary alloys, 4D dynamics, multislice, real experimental from published studies, Brownian Pt nanocrystals), 14 primary reconstruction methods from 5 algorithmic families (plus supplementary baselines), 4 evaluation tasks, and 14,000+ result rows.",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://huggingface.co/datasets/pone7/4D-ATE",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0.0",
  "datePublished": "2026-04-10",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Zicheng Liu"
    },
    {
      "@type": "sc:Person",
      "name": "Wenzhuo Ma"
    },
    {
      "@type": "sc:Person",
      "name": "Jintao Chen"
    },
    {
      "@type": "sc:Person",
      "name": "Di Huang"
    }
  ],
  "keywords": [
    "atomic electron tomography",
    "HAADF-STEM",
    "3D reconstruction",
    "4D dynamic imaging",
    "Gaussian splatting",
    "benchmark",
    "nanoparticle",
    "materials science"
  ],
